# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git - it's already in .gitignore

# API Configuration
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=Dev-Link-Hub
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=A full-stack web application for developers to manage and share useful links/resources

# Authentication
VITE_AUTH_REDIRECT_URI=http://localhost:3000/callback

# GitHub OAuth (optional)
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Google OAuth (optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=UA_your_tracking_id
VITE_SENTRY_DSN=https://your_sentry_url@sentry.io/project_id

# Feature Flags
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PWA=false

# Environment
VITE_ENV=development

# Logging
VITE_LOG_LEVEL=debug

# Build Configuration
VITE_GENERATE_SOURCEMAP=true
